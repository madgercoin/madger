{
  "expo": {
    "name": "MADGER",
    "slug": "dollarmadger",
    "owner": "madgercoins-team",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/madger-app-icon.png",
    "scheme": "madger",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.madgercoin.app",
      "buildNumber": "4",
      "icon": "./assets/images/madger-app-icon.png",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false
        }
      }
    },
    "android": {
      "package": "com.madgercoin.app",
      "versionCode": 4,
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#030500",
        "foregroundImage": "./assets/images/madger-adaptive-foreground.png",
        "monochromeImage": "./assets/images/madger-adaptive-monochrome.png"
      },
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#030500",
          "image": "./assets/images/madger-splash.png",
          "imageWidth": 220,
          "resizeMode": "contain"
        }
      ],
      "expo-video",
      "expo-image",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "e4c06d4a-4d6c-44da-b405-624382b15c56"
      }
    }
  }
}
