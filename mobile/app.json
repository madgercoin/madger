{
  "expo": {
    "name": "MADGER",
    "slug": "madger",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/madger-app-icon.png",
    "scheme": "madger",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.madgercoin.app",
      "buildNumber": "1",
      "icon": "./assets/images/madger-app-icon.png",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false
        }
      }
    },
    "android": {
      "package": "com.madgercoin.app",
      "versionCode": 1,
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "backgroundColor": "#030500",
        "foregroundImage": "./assets/images/madger-adaptive-foreground.png",
        "monochromeImage": "./assets/images/madger-adaptive-monochrome.png"
      },
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#030500",
          "image": "./assets/images/madger-splash.png",
          "imageWidth": 220,
          "resizeMode": "contain"
        }
      ],
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "REPLACE_WITH_EAS_PROJECT_ID"
      }
    }
  }
}
